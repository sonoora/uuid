# Existing Circle Entity Secret and public key; UUID never needs CIRCLE_API_KEY.
ENTITY_SECRET=
PUBLIC_KEY=
# Server-only, distinct 64-character lowercase hex values. Never paste real values in git.
API_KEY_DEV=
API_KEY_PROD=
UUID_ISSUANCE_ENABLED=false
# Existing databases, TLS required. Login role belongs to exactly one sonoora_uuid_{dev,prod} group.
# Runtime must NOT own uuid_audit or have direct table writes / owner membership.
UUID_AUDIT_DATABASE_URL_DEV=
UUID_AUDIT_DATABASE_URL_PROD=
